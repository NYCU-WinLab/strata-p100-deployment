[Unit]
Description=Strata: pass the LLM gateway's connections on to the service on 127.0.0.1:8080 (decision 0008)
Requires=strata-gateway-proxy.socket
After=strata-gateway-proxy.socket

[Service]
# 32 does not limit the work: the gateway admits 4 requests a slot, and the service queues what its 4 slots cannot take.
# At the limit the proxy resets a connection instead of queueing it, so the limit stays well above what two gateway
# slots open during a cutover.  It has no dependency on strata-q3.service, which it never starts or stops: while that
# is down, a connection just ends
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=32 127.0.0.1:8080
# A user of its own for each run.  This implies ProtectSystem=strict, ProtectHome=read-only, PrivateTmp=yes and
# NoNewPrivileges=yes; it needs no file and no capability
DynamicUser=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# What the socket unit allows covers the sockets it passes on, not those this process opens: these reach loopback only
IPAddressAllow=localhost
IPAddressDeny=any
